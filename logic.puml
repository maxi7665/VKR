@startuml
hide circle
skinparam linetype ortho

' ========== Основные справочники ==========

entity "Транспортное средство" as vehicle {
  * идентификатор : <<PK>>
  --
  название
  госномер
  идентификатор_устройства : <<unique>>
  тип_тс
  подразделение
  дата_создания
}

entity "Геозона" as geozone {
  * идентификатор : <<PK>>
  --
  название
  тип_геозоны
  геометрия
  активна
}

' ========== Телеметрические данные ==========

entity "Пакет телеметрии" as packet {
  * идентификатор : <<PK>>
  --
  * транспортное_средство : <<FK>>
  время_пакета
  время_приёма
  ключ S2
  широта
  долгота
}

entity "Подзапись телеметрии" as subrecord {
  * идентификатор : <<PK>>
  --
  * пакет : <<FK>>
  тип_записи
  высота
  скорость
  курс
  одометр
  данные_датчиков
  метка_времени
}

' ========== События ==========

entity "Телеметрическое событие" as tevent {
  * идентификатор : <<PK>>
  --
  * транспортное_средство : <<FK>>
  * тип_события : <<FK>>
  время_события
  значение
  порог
  подзапись : <<FK>>
}

entity "Событие геозоны" as gevent {
  * идентификатор : <<PK>>
  --
  * транспортное_средство : <<FK>>
  * геозона : <<FK>>
  * тип_события
  время_события
  пакет : <<FK>>
}

' ========== Настройки событий ==========

entity "Тип телеметрического события" as te_config {
  * тип_события : <<PK>>
  --
  параметры
  включено
  описание
}

entity "Настройка событий геозоны" as gz_config {
  * геозона : <<PK, FK>>
  * тип_события : <<PK>>
  --
  включено
}

' ========== Общие настройки ==========

entity "Общие настройки" as settings {
  * ключ : <<PK>>
  --
  значение
  описание
}

' =================================
' Связи
' =================================

vehicle ||--o{ packet : "передаёт"
packet ||--o{ subrecord : "содержит"

vehicle ||--o{ tevent : "генерирует"
vehicle ||--o{ gevent : "участвует в"

geozone ||--o{ gevent : "зона события"
geozone ||--o{ gz_config : "настройка событий"

subrecord ||--o| tevent : "источник"
packet ||--o| gevent : "фиксация координат"

te_config ||--o{ tevent : "определяет порог"
gz_config ||--o{ gevent : "правила для зоны"

@enduml